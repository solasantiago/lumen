{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solasantiago.github.io/lumen/schema/materia.schema.json",
  "title": "Materia (contrato Lumen v1)",
  "description": "Archivo lumen.json que mantiene el agente de cada materia en su repo. Lumen lo sincroniza y lo muestra. Documentación: docs/contrato.md.",
  "type": "object",
  "required": ["esquema", "id", "nombre", "unidades", "evaluaciones"],
  "additionalProperties": false,
  "properties": {
    "esquema": { "const": "lumen/materia@1" },
    "id": { "$ref": "#/$defs/slug", "description": "Igual al id de la materia en data/lumen.json de Lumen." },
    "nombre": { "type": "string", "minLength": 1 },
    "abreviatura": { "type": "string", "minLength": 1, "examples": ["AM2", "SO"] },
    "actualizado": { "type": "string", "format": "date-time", "description": "Última vez que el agente escribió el archivo." },
    "programa": {
      "type": "object",
      "description": "Datos del programa analítico. Informativo.",
      "properties": {
        "plan": { "type": "string" },
        "anio_programa": { "type": "integer" },
        "nivel": { "type": "integer", "minimum": 1, "description": "Nivel (año) de la carrera en el que está la materia." },
        "area": { "type": "string" },
        "bloque": { "type": "string" },
        "horas_reloj": { "type": "number" },
        "horas_catedra": { "type": "number" },
        "modalidad": { "type": "string" },
        "fuente": { "type": "string" }
      }
    },
    "unidades": {
      "type": "array",
      "minItems": 1,
      "description": "En orden de cursada.",
      "items": { "$ref": "#/$defs/unidad" }
    },
    "evaluaciones": {
      "type": "array",
      "description": "En orden cronológico.",
      "items": { "$ref": "#/$defs/evaluacion" }
    },
    "aprobacion": {
      "type": "object",
      "properties": {
        "promocion": { "$ref": "#/$defs/regimen" },
        "regularizacion": { "$ref": "#/$defs/regimen" },
        "notas": { "type": "string" }
      }
    },
    "sesiones": {
      "type": "array",
      "description": "Registro de sesiones de estudio.",
      "items": { "$ref": "#/$defs/sesion" }
    },
    "extra": { "type": "object", "description": "Datos propios del agente de la materia. Lumen no los lee." }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unidad": {
      "type": "object",
      "required": ["id", "nombre", "temas"],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Estable: no cambiarlo una vez creado." },
        "numero": { "type": "string", "examples": ["IV", "3", "X·1"] },
        "nombre": { "type": "string", "minLength": 1 },
        "peso": { "type": "number", "exclusiveMinimum": 0, "default": 1, "description": "Importancia relativa dentro de la materia (p. ej. clases dedicadas)." },
        "temas": { "type": "array", "items": { "$ref": "#/$defs/tema" } }
      }
    },
    "tema": {
      "type": "object",
      "required": ["id", "nombre", "nivel"],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Único dentro de la materia y estable." },
        "nombre": { "type": "string", "minLength": 1 },
        "nivel": {
          "type": "integer", "minimum": 0, "maximum": 4,
          "description": "0 no visto · 1 visto · 2 entendido · 3 practicado · 4 dominado. Criterios en docs/contrato.md."
        },
        "porcentaje": { "type": "number", "description": "Opcional y derivado: nivel × 25. Lumen siempre lo recalcula." },
        "peso": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "evidencia": { "$ref": "#/$defs/evidencia" },
        "notas": { "type": "string" }
      }
    },
    "evidencia": {
      "type": "object",
      "properties": {
        "ejercicios": {
          "type": "object",
          "required": ["hechos", "total"],
          "properties": {
            "hechos": { "type": "integer", "minimum": 0 },
            "correctos": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        },
        "autoevaluaciones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fecha", "puntaje"],
            "properties": {
              "fecha": { "$ref": "#/$defs/fecha" },
              "puntaje": { "type": "number", "minimum": 0, "maximum": 1 },
              "tipo": { "type": "string", "examples": ["quiz", "simulacro", "oral"] }
            }
          }
        },
        "ultimo_repaso": { "$ref": "#/$defs/fecha" },
        "proximo_repaso": { "$ref": "#/$defs/fecha" },
        "minutos": { "type": "number", "minimum": 0 }
      }
    },
    "evaluacion": {
      "type": "object",
      "required": ["id", "nombre", "tipo", "unidades"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "nombre": { "type": "string", "minLength": 1 },
        "tipo": { "enum": ["parcial", "recuperatorio", "final", "tp", "integrador", "otro"] },
        "fecha": { "oneOf": [{ "$ref": "#/$defs/fecha" }, { "type": "null" }] },
        "unidades": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } },
        "nota": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 10 }, { "type": "null" }] },
        "estado": { "enum": ["pendiente", "aprobado", "desaprobado", "ausente"] }
      }
    },
    "regimen": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["nota_minima", "descripcion"],
          "properties": { "nota_minima": { "type": "number" }, "descripcion": { "type": "string" } }
        }
      ]
    },
    "sesion": {
      "type": "object",
      "required": ["fecha", "minutos"],
      "properties": {
        "fecha": { "$ref": "#/$defs/fecha" },
        "minutos": { "type": "number", "exclusiveMinimum": 0 },
        "tipo": { "enum": ["clase", "teoria", "practica", "repaso", "simulacro"] },
        "temas": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "notas": { "type": "string" }
      }
    }
  }
}
